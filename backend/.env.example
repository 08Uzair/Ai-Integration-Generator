# AI Integration Generator - Backend
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

MONGO_URI=mongodb://localhost:27017/ai_integration_generator

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
RATE_LIMIT_STRICT_MAX=10

# SSRF protection: private networks blocked unless explicitly allowlisted (dev only)
ALLOWED_PRIVATE_HOSTS=localhost,127.0.0.1
REQUEST_TIMEOUT_MS=10000

ARTIFACT_TTL_HOURS=24
# Where generated projects + zips are stored. Defaults to <workspace>/generated
ARTIFACT_DIR=