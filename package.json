{
  "name": "ai-integration-generator",
  "version": "1.0.0",
  "private": true,
  "description": "Generate a customized AI Server, MCP Server, AI Chat Client, Docker configuration and documentation for any existing API.",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "generator",
    "cli"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "cli": "npm run start -w cli",
    "build": "npm run build -w frontend",
    "start:backend": "npm run start -w backend",
    "lint": "eslint . --ignore-pattern 'generated' --ignore-pattern 'frontend/.next'",
    "format": "prettier --write \"**/*.{js,jsx,json,md,yml,yaml}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^15.9.0",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=18.17"
  }
}
