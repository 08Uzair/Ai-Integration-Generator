# ===== AI Integration Generator platform =====

# ---- Backend ----
PORT=4000
NODE_ENV=development
# Comma separated list of allowed browser origins (CORS)
CORS_ORIGINS=http://localhost:3000

# -------- MongoDB --------
MONGO_URI=mongodb://localhost:27017/ai_integration_generator

# -------- Security --------
# Rate limits (requests per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
RATE_LIMIT_STRICT_MAX=10

# -------- SSRF protection --------
# Private networks are blocked by default. In development only, allow
# explicitly listed private hosts so local APIs (e.g. http://localhost:3000)
# can be discovered. Leave empty in production.
ALLOWED_PRIVATE_HOSTS=localhost,127.0.0.1
# HTTP client timeout in milliseconds for all outbound requests
REQUEST_TIMEOUT_MS=10000

# Generated artifact retention (hours). Older artifacts are cleaned up.
ARTIFACT_TTL_HOURS=24

# -------- Frontend (browser) --------
NEXT_PUBLIC_API_URL=http://localhost:4000